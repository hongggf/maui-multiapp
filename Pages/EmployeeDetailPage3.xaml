<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pages.EmployeeDetailPage3"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             Title="Employee Profile"
             x:DataType="vm:EmployeeDetailViewModels3"
             BackgroundColor="#0A0D16">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="20">

            <!-- Profile Hero Banner -->
            <Border BackgroundColor="#131726"
                    Stroke="#22293F"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="24,28">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">

                    <!-- Avatar Circle -->
                    <Border WidthRequest="84" HeightRequest="84"
                            StrokeShape="RoundRectangle 42"
                            BackgroundColor="#1E1B4B"
                            Stroke="#6366F1"
                            StrokeThickness="2"
                            HorizontalOptions="Center">
                        <Label Text="{Binding Employee.Initials}"
                               TextColor="#A5B4FC"
                               FontAttributes="Bold"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Name & Subtitle -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding Employee.EmployeeName}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Employee.Email}"
                               FontSize="13"
                               TextColor="#818CF8"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Badges Row -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <!-- ID Badge -->
                        <Border BackgroundColor="#0C0F1A"
                                Stroke="#262E45"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,5">
                            <Label Text="{Binding Employee.EmployeeId, StringFormat='ID: {0}'}"
                                   TextColor="#818CF8"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                        </Border>

                        <!-- Work Type Badge -->
                        <Border BackgroundColor="{Binding Employee.WorkTypeBg}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,5">
                            <Label Text="{Binding Employee.WorkType}"
                                   TextColor="{Binding Employee.WorkTypeColor}"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Details Card -->
            <Border BackgroundColor="#131726"
                    Stroke="#22293F"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                <VerticalStackLayout Spacing="16">

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="📋" FontSize="16" VerticalOptions="Center" />
                        <Label Text="EMPLOYEE INFORMATION"
                               TextColor="#94A3B8"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#1E2638" Margin="0,-4,0,0" />

                    <!-- Employee ID -->
                    <Grid ColumnDefinitions="36, *, Auto" VerticalOptions="Center">
                        <Label Text="🆔" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Employee ID" TextColor="#64748B" FontSize="11" />
                            <Label Text="{Binding Employee.EmployeeId}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E2638" />

                    <!-- Full Name -->
                    <Grid ColumnDefinitions="36, *, Auto" VerticalOptions="Center">
                        <Label Text="👤" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Full Name" TextColor="#64748B" FontSize="11" />
                            <Label Text="{Binding Employee.EmployeeName}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E2638" />

                    <!-- Email -->
                    <Grid ColumnDefinitions="36, *, Auto" VerticalOptions="Center">
                        <Label Text="✉️" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Email Address" TextColor="#64748B" FontSize="11" />
                            <Label Text="{Binding Employee.Email}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E2638" />

                    <!-- Part-Time Toggle -->
                    <Grid ColumnDefinitions="36, *, Auto" VerticalOptions="Center">
                        <Label Text="⏱️" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Part-Time Status" TextColor="#64748B" FontSize="11" />
                            <Label Text="{Binding Employee.WorkType}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                IsToggled="{Binding Employee.IsPartTime}"
                                OnColor="#6366F1"
                                ThumbColor="#FFFFFF"
                                VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Navigation Button -->
            <Button Text="← Back to Employee Directory"
                    Clicked="OnBackClicked"
                    BackgroundColor="#1E293B"
                    TextColor="#818CF8"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="12"
                    HeightRequest="48" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
