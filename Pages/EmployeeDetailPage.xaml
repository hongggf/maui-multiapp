<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pages.EmployeeDetailPage"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             Title="Employee Details"
             x:DataType="vm:EmployeeDetailViewModels"
             BackgroundColor="#0A0D16">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="20">

            <!-- Profile Hero Banner -->
            <Border BackgroundColor="#131726"
                    Stroke="#22293F"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="24,28">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border WidthRequest="84" HeightRequest="84"
                            StrokeShape="RoundRectangle 42"
                            BackgroundColor="#1E1B4B"
                            Stroke="#6366F1"
                            StrokeThickness="2"
                            HorizontalOptions="Center">
                        <Label Text="JT"
                               TextColor="#A5B4FC"
                               FontAttributes="Bold"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding EmployeeName}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Email}"
                               FontSize="13"
                               TextColor="#818CF8"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="#0C0F1A"
                            Stroke="#262E45"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,5"
                            HorizontalOptions="Center">
                        <Label Text="{Binding EmployeeID, StringFormat='ID: {0}'}"
                               TextColor="#818CF8"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Details Card -->
            <Border BackgroundColor="#131726"
                    Stroke="#22293F"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                <VerticalStackLayout Spacing="16">

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="📋" FontSize="16" VerticalOptions="Center" />
                        <Label Text="BASIC INFORMATION"
                               TextColor="#94A3B8"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#1E2638" Margin="0,-4,0,0" />

                    <Grid ColumnDefinitions="36, *, Auto" VerticalOptions="Center">
                        <Label Text="🆔" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Employee ID" TextColor="#64748B" FontSize="11" />
                            <Label Text="{Binding EmployeeID}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E2638" />

                    <Grid ColumnDefinitions="36, *, Auto" VerticalOptions="Center">
                        <Label Text="👤" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Full Name" TextColor="#64748B" FontSize="11" />
                            <Label Text="{Binding EmployeeName}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E2638" />

                    <Grid ColumnDefinitions="36, *, Auto" VerticalOptions="Center">
                        <Label Text="✉️" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Email Address" TextColor="#64748B" FontSize="11" />
                            <Label Text="{Binding Email}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E2638" />

                    <Grid ColumnDefinitions="36, *, Auto" VerticalOptions="Center">
                        <Label Text="⏱️" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Part-Time Status" TextColor="#64748B" FontSize="11" />
                            <Label Text="Is Part-Time Active" TextColor="#FFFFFF" FontSize="13" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                IsToggled="{Binding IsPartTime}"
                                OnColor="#6366F1"
                                ThumbColor="#FFFFFF"
                                VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
