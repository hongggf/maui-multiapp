<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pages.EmployeeListPage"
             Title="Employee Directory"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             xmlns:models="clr-namespace:MauiApp1.Models"
             x:DataType="vm:EmployeeListViewModel"
             BackgroundColor="#0A0D16">

    <Grid RowDefinitions="Auto, *" Padding="16,14" RowSpacing="16">

        <!-- Top Card: Add Employee Form -->
        <Border BackgroundColor="#131726"
                Stroke="#22293F"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="16">
            <VerticalStackLayout Spacing="12">

                <!-- Header -->
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border WidthRequest="34" HeightRequest="34"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#1E1B4B"
                            Stroke="#4338CA"
                            StrokeThickness="1">
                        <Label Text="👤" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label Text="REGISTER EMPLOYEE"
                               TextColor="#FFFFFF"
                               FontAttributes="Bold"
                               FontSize="13" />
                        <Label Text="Fill in details to add to team directory"
                               TextColor="#818CF8"
                               FontSize="11" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Input Row 1: ID & Name -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Border BackgroundColor="#0C0F1A"
                            Stroke="#262E45"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,2">
                        <Entry Placeholder="Employee ID"
                               PlaceholderColor="#475569"
                               TextColor="#FFFFFF"
                               FontSize="13"
                               Text="{Binding Employee.EmployeeId}" />
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="#0C0F1A"
                            Stroke="#262E45"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,2">
                        <Entry Placeholder="Full Name"
                               PlaceholderColor="#475569"
                               TextColor="#FFFFFF"
                               FontSize="13"
                               Text="{Binding Employee.EmployeeName}" />
                    </Border>
                </Grid>

                <!-- Input Row 2: Email & Part-Time Switch -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Border BackgroundColor="#0C0F1A"
                            Stroke="#262E45"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,2">
                        <Entry Placeholder="Email Address"
                               PlaceholderColor="#475569"
                               TextColor="#FFFFFF"
                               FontSize="13"
                               Keyboard="Email"
                               Text="{Binding Employee.Email}" />
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="#0C0F1A"
                            Stroke="#262E45"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,4"
                            VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Part-Time" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center" />
                            <Switch IsToggled="{Binding Employee.IsPartTime}"
                                    OnColor="#6366F1"
                                    ThumbColor="#FFFFFF" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Add Button -->
                <Button Text="+ Add Employee to List"
                        Command="{Binding AddCommand}"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="10"
                        HeightRequest="44" />
            </VerticalStackLayout>
        </Border>

        <!-- Bottom Section: Employee List -->
        <Border Grid.Row="1"
                BackgroundColor="#131726"
                Stroke="#22293F"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="0">
            <Grid RowDefinitions="Auto, *">

                <!-- Header Banner -->
                <Border BackgroundColor="#171C2E"
                        Stroke="Transparent"
                        Padding="16,12">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="📋" FontSize="16" VerticalOptions="Center" />
                        <Label Text="Team Members" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                        <Label Text="(Tap any member to view details)" TextColor="#818CF8" FontSize="11" VerticalOptions="Center" Margin="6,0,0,0" />
                    </HorizontalStackLayout>
                </Border>

                <!-- ListView with Custom Styled ViewCell -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Employees}"
                          ItemTapped="ListView_ItemTapped"
                          BackgroundColor="Transparent"
                          SeparatorColor="#1E2638"
                          HasUnevenRows="True"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Employee">
                            <ViewCell>
                                <Grid ColumnDefinitions="46, *, Auto, Auto"
                                      Padding="16,10"
                                      ColumnSpacing="12"
                                      VerticalOptions="Center">

                                    <!-- Avatar Initials -->
                                    <Border WidthRequest="44" HeightRequest="44"
                                            StrokeShape="RoundRectangle 22"
                                            BackgroundColor="#1E1B4B"
                                            Stroke="#4338CA"
                                            StrokeThickness="1"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Initials}"
                                               TextColor="#A5B4FC"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Employee Info -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding EmployeeName}"
                                                   TextColor="#FFFFFF"
                                                   FontAttributes="Bold"
                                                   FontSize="14" />
                                            <Label Text="{Binding EmployeeId, StringFormat='ID: {0}'}"
                                                   TextColor="#64748B"
                                                   FontSize="11"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Email}"
                                               TextColor="#94A3B8"
                                               FontSize="11" />
                                    </VerticalStackLayout>

                                    <!-- Work Type Badge -->
                                    <Border Grid.Column="2"
                                            BackgroundColor="{Binding WorkTypeBg}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,3"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding WorkType}"
                                               TextColor="{Binding WorkTypeColor}"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <!-- Chevron -->
                                    <Label Grid.Column="3"
                                           Text="›"
                                           TextColor="#64748B"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           Margin="2,0,0,0" />
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
