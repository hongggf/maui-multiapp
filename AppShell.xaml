<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:MauiApp1"
       xmlns:pages="clr-namespace:MauiApp1.Pages"
       x:Class="MauiApp1.AppShell"
       FlyoutBehavior="Flyout"
       Title="MAUI Exercises"
       Shell.BackgroundColor="#0F111A"
       Shell.ForegroundColor="#6366F1"
       Shell.TitleColor="#FFFFFF"
       Shell.UnselectedColor="#94A3B8"
       FlyoutBackgroundColor="#0F111A">

    <Shell.FlyoutHeader>
        <Border Margin="16,24,16,16"
                Padding="18"
                StrokeShape="RoundRectangle 16"
                Stroke="#282F44"
                StrokeThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1C2136" Offset="0.0" />
                    <GradientStop Color="#101320" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Border WidthRequest="42" HeightRequest="42"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#6366F1"
                            Stroke="Transparent">
                        <Label Text="✦"
                               TextColor="White"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="MAUI EXERCISES"
                               TextColor="#FFFFFF"
                               FontAttributes="Bold"
                               FontSize="17" />
                        <Label Text="MVVM Architecture"
                               TextColor="#818CF8"
                               FontSize="12" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <BoxView HeightRequest="1" Color="#252C42" Margin="0,8,0,4" />
                <Label Text="Select an exercise from the drawer"
                       TextColor="#94A3B8"
                       FontSize="11" />
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <!-- EXERCISES IN DRAWER -->
    <FlyoutItem Title="Exercise 1: Basic ViewModel" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate pages:EmployeeDetailPage}" Route="EmployeeDetailPage" />
    </FlyoutItem>

    <FlyoutItem Title="Exercise 2: INotifyPropertyChanged" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate pages:Exercise2Page}" Route="Exercise2Page" />
    </FlyoutItem>

    <FlyoutItem Title="Exercise 3: CommunityToolkit.MVVM" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate pages:Exercise3Page}" Route="Exercise3Page" />
    </FlyoutItem>

    <FlyoutItem Title="Exercise 4: Employee List &amp; CRUD" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate pages:EmployeeListPage}" Route="EmployeeListPage" />
    </FlyoutItem>

    <!-- UTILITY TOOLS -->
    <FlyoutItem Title="Loan Calculator" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Temp Converter" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate local:TemperaturePage}" Route="TemperaturePage" />
    </FlyoutItem>

    <FlyoutItem Title="Quote Generator" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate local:QuotePage}" Route="QuotePage" />
    </FlyoutItem>

    <FlyoutItem Title="Calculator" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate local:CalculatorPage}" Route="CalculatorPage" />
    </FlyoutItem>

</Shell>