<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.CalculatorPage"
             Title="Calculator"
             BackgroundColor="#0A0D16">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="NumBtn" TargetType="Button">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="#171B2B" />
                <Setter Property="TextColor" Value="#F8FAFC" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
            <Style x:Key="FuncBtn" TargetType="Button" BasedOn="{StaticResource NumBtn}">
                <Setter Property="BackgroundColor" Value="#1C2236" />
                <Setter Property="TextColor" Value="#38BDF8" />
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style x:Key="OpBtn" TargetType="Button" BasedOn="{StaticResource NumBtn}">
                <Setter Property="BackgroundColor" Value="#4F46E5" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="EqualsBtn" TargetType="Button" BasedOn="{StaticResource NumBtn}">
                <Setter Property="BackgroundColor" Value="#10B981" />
                <Setter Property="TextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="14,16" RowDefinitions="Auto,*" RowSpacing="14">

        <!-- Display Card -->
        <Border Grid.Row="0"
                BackgroundColor="#111524"
                Stroke="#21283E"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="16,12">
            <VerticalStackLayout Spacing="2">
                <!-- Expression / history line -->
                <Label x:Name="ExpressionLabel"
                       Text=""
                       FontSize="16"
                       TextColor="#94A3B8"
                       HorizontalTextAlignment="End"
                       HeightRequest="24" />

                <!-- Main display -->
                <Label x:Name="DisplayLabel"
                       Text="0"
                       FontSize="44"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalTextAlignment="End"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Border>

        <!-- Button grid -->
        <Grid Grid.Row="1"
              RowDefinitions="*,*,*,*,*,*"
              ColumnDefinitions="*,*,*,*"
              RowSpacing="10" ColumnSpacing="10">

            <Button Grid.Row="0" Grid.Column="0" Text="%"   Clicked="OnPercent"   Style="{StaticResource FuncBtn}" />
            <Button Grid.Row="0" Grid.Column="1" Text="CE"  Clicked="OnClearEntry" Style="{StaticResource FuncBtn}" />
            <Button Grid.Row="0" Grid.Column="2" Text="C"   Clicked="OnClearAll"  Style="{StaticResource FuncBtn}" />
            <Button Grid.Row="0" Grid.Column="3" Text="⌫"   Clicked="OnBackspace" Style="{StaticResource FuncBtn}" />

            <Button Grid.Row="1" Grid.Column="0" Text="1/x" Clicked="OnReciprocal" Style="{StaticResource FuncBtn}" />
            <Button Grid.Row="1" Grid.Column="1" Text="x²"  Clicked="OnSquare"     Style="{StaticResource FuncBtn}" />
            <Button Grid.Row="1" Grid.Column="2" Text="√x"  Clicked="OnSquareRoot" Style="{StaticResource FuncBtn}" />
            <Button Grid.Row="1" Grid.Column="3" Text="÷"   Clicked="OnOperator"   Style="{StaticResource OpBtn}" />

            <Button Grid.Row="2" Grid.Column="0" Text="7" Clicked="OnDigit" Style="{StaticResource NumBtn}" />
            <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnDigit" Style="{StaticResource NumBtn}" />
            <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnDigit" Style="{StaticResource NumBtn}" />
            <Button Grid.Row="2" Grid.Column="3" Text="×" Clicked="OnOperator" Style="{StaticResource OpBtn}" />

            <Button Grid.Row="3" Grid.Column="0" Text="4" Clicked="OnDigit" Style="{StaticResource NumBtn}" />
            <Button Grid.Row="3" Grid.Column="1" Text="5" Clicked="OnDigit" Style="{StaticResource NumBtn}" />
            <Button Grid.Row="3" Grid.Column="2" Text="6" Clicked="OnDigit" Style="{StaticResource NumBtn}" />
            <Button Grid.Row="3" Grid.Column="3" Text="−" Clicked="OnOperator" Style="{StaticResource OpBtn}" />

            <Button Grid.Row="4" Grid.Column="0" Text="1" Clicked="OnDigit" Style="{StaticResource NumBtn}" />
            <Button Grid.Row="4" Grid.Column="1" Text="2" Clicked="OnDigit" Style="{StaticResource NumBtn}" />
            <Button Grid.Row="4" Grid.Column="2" Text="3" Clicked="OnDigit" Style="{StaticResource NumBtn}" />
            <Button Grid.Row="4" Grid.Column="3" Text="+" Clicked="OnOperator" Style="{StaticResource OpBtn}" />

            <Button Grid.Row="5" Grid.Column="0" Text="+/-" Clicked="OnToggleSign" Style="{StaticResource FuncBtn}" />
            <Button Grid.Row="5" Grid.Column="1" Text="0"   Clicked="OnDigit"      Style="{StaticResource NumBtn}" />
            <Button Grid.Row="5" Grid.Column="2" Text="."   Clicked="OnDecimal"    Style="{StaticResource NumBtn}" />
            <Button Grid.Row="5" Grid.Column="3" Text="="   Clicked="OnEquals"     Style="{StaticResource EqualsBtn}" />

        </Grid>
    </Grid>

</ContentPage>